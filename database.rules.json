{
  "rules": {
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "tarefas": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$tarefaId": {
          ".validate": "newData.hasChildren(['titulo', 'dataVencimento', 'prioridade', 'concluida']) && newData.child('titulo').isString() && newData.child('dataVencimento').isNumber() && newData.child('concluida').isBoolean()"
        }
      }
    }
  }
}
